{
  "rules": {
    ".read": false,
    ".write": false,
    "stareDown": {
      "rooms": {
        "$code": {
          ".read": true,
          ".write": "auth != null && $code.matches(/^[0-9]{4}$/) && (!data.exists() || data.child('at').val() < now - 7200000)",
          ".validate": "newData.hasChild('at')",
          "at": {
            ".validate": "newData.val() === now || newData.val() === data.val()"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('at').exists()",
              ".validate": "newData.hasChildren(['skin', 'ready'])",
              "skin": { ".validate": "newData.isString() && newData.val().length <= 8" },
              "ready": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "start": {
            "$round": {
              ".write": "auth != null && !data.exists() && root.child('stareDown/rooms/' + $code + '/players/' + auth.uid).exists()",
              ".validate": "newData.isNumber() && newData.val() > now - 60000 && newData.val() < now + 60000"
            }
          },
          "outs": {
            "$round": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('stareDown/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.hasChildren(['ms', 'why'])",
                "ms": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600000" },
                "why": { ".validate": "newData.val() === 'blink' || newData.val() === 'face' || newData.val() === 'time'" },
                "$other": { ".validate": false }
              }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "faces": {
        "$code": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "l": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "r": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "j": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "b": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "t": { ".validate": "newData.isNumber() && newData.val() >= -1.6 && newData.val() <= 1.6" },
            "f": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
